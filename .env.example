# Database Connection
# Supported formats:
# - SQLite:  sqlite://path/to/database.sqlite
# - MySQL:   mysql://user:password@localhost:3306/database
COMMENT_DB_URL=sqlite://comments.sqlite

# The site name to distinguish comments in a shared database
COMMENT_SITE_NAME=default

# Table name for comments (defaults to "comments")
COMMENT_TABLE_NAME=comments

# --- User Table Joining (optional) ---
# If you want to merge author information (username, avatar) automatically into comments:
COMMENT_USER_TABLE_NAME=users
COMMENT_USER_ID_COL=id
COMMENT_USER_NAME_COL=name
COMMENT_USER_AVATAR_COL=image

# --- Redis (optional) ---
# ioredis-compatible connection URL
COMMENT_REDIS_URL=redis://localhost:6379

# Set to "true" to enable Redis caching + Redis-backed rate limiting.
# Requires COMMENT_REDIS_URL and the "ioredis" package (npm i ioredis).
COMMENT_ENABLE_REDIS=false

# --- Rate limiting ---
# Max requests per IP per window (default: 60)
COMMENT_RATE_LIMIT_MAX=60
# Window size in seconds (default: 60)
COMMENT_RATE_LIMIT_WINDOW_SEC=60
