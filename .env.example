# Database Connection
# Supported formats: 
# - SQLite: sqlite://path/to/database.sqlite
# - MySQL: mysql://user:password@localhost:3306/database
COMMENT_DB_URL=sqlite://comments.sqlite

# Optional Configurations
# The site name to distinguish comments for a shared database
COMMENT_SITE_NAME=default

# Table name for the comments, defaults to "comments"
COMMENT_TABLE_NAME=comments
